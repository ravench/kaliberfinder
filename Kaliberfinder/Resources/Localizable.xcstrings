    "Umriss auf dem Foto: grün Spitze und Boden, violett Geschoss, orange Hals und Schulter, hellblau Verjüngung des Körpers.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Outline on the photo: green tip and base, purple bullet, orange neck and shoulder, light blue body taper."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Contour sur la photo : vert pointe et culot, violet projectile, orange collet et épaulement, bleu clair conicité du corps."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Contorno sulla foto: verde punta e fondello, viola palla, arancione colletto e spalla, azzurro conicità del corpo."
          }
        }
      }
    },
