    "Unbelegt: Masse in calibre-data nicht gut belegt, Teile der Zeichnung geschätzt. Nur mit der Entwickleroption sichtbar.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Unsourced: dimensions not well sourced in calibre-data, parts of the drawing are estimated. Shown with the developer option only."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
