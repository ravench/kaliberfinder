          "stringUnit": {
            "state": "translated",
            "value": "Distance outside 12–45 cm: size not measured, matches by shape and marking only."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Distance hors de 12–45 cm : taille non mesurée, résultats selon la forme et l'inscription seulement."
