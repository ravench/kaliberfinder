    "Bildschirm nicht kalibriert: Grösse kann leicht abweichen.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Screen not calibrated: the size may be slightly off."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Écran non calibré : la taille peut légèrement différer."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Schermo non calibrato: la dimensione può differire leggermente."
          }
        }
      }
    },
    "Bildschirmzoom und Kalibrierung werden berücksichtigt. Prüfe die Grösse einmal mit einer Bankkarte.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Display Zoom and calibration are taken into account. Check the size once with a bank card."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le zoom d'affichage et la calibration sont pris en compte. Vérifiez la taille une fois avec une carte bancaire."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Lo zoom dello schermo e la calibrazione vengono considerati. Controlla la dimensione una volta con una carta bancaria."
          }
        }
      }
    },
