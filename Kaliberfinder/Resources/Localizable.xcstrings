      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Saves photo series of known cartridges with the app's measurements on the device, as test data for recognition."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Enregistre sur l'appareil des séries de photos de cartouches connues avec les mesures de l'app, comme données de test pour la reconnaissance."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
