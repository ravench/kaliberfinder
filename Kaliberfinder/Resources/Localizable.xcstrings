    "Fülle aus, was du messen kannst. Schon eine Länge und ein Durchmesser grenzen die Auswahl stark ein.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Fill in what you can measure. One length and one diameter already narrow it down a lot."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Remplissez ce que vous pouvez mesurer. Une longueur et un diamètre suffisent déjà à bien réduire le choix."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Compila ciò che puoi misurare. Già una lunghezza e un diametro restringono molto la scelta."
          }
        }
      }
    },
