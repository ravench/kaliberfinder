    "Abstand ausserhalb 12–45 cm: Grösse nicht gemessen, Treffer nur nach Form.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Distance outside 12–45 cm: size not measured, matches by shape only."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Distance hors de 12–45 cm : taille non mesurée, résultats selon la forme seulement."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Distanza fuori da 12–45 cm: dimensione non misurata, risultati solo per forma."
          }
        }
      }
    },
