    "Auch Kaliber vorschlagen, die nicht mehr regulär hergestellt werden, z. B. GP 1890 oder Vetterli. «Alle Kaliber» zeigt sie immer.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Also suggest calibres that are no longer in regular production, e.g. GP 1890 or Vetterli. “All calibres” always shows them."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Proposer aussi des calibres qui ne sont plus fabriqués en série, p. ex. GP 1890 ou Vetterli. « Tous les calibres » les affiche toujours."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Proporre anche calibri non più prodotti regolarmente, p. es. GP 1890 o Vetterli. «Tutti i calibri» li mostra sempre."
          }
        }
      }
    },
