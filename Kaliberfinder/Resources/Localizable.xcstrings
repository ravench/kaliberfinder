    "Rund im Bild: Boden oder Spitze einer Patrone, oder eine Rundkugel. Bei Patronen zählt nur die Aufschrift.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Round in the photo: the base or tip of a cartridge, or a round ball. For cartridges only the marking counts."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Rond sur la photo : culot ou pointe d'une cartouche, ou une balle ronde. Pour les cartouches, seule l'inscription compte."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Rotondo nella foto: fondello o punta di una cartuccia, oppure una palla sferica. Per le cartucce conta solo la scritta."
          }
        }
      }
    },
