    "Rund im Bild: Boden oder Spitze einer Patrone, oder eine Rundkugel. Patronen werden nur von der Seite erkannt.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Round in the photo: the base or tip of a cartridge, or a round ball. Cartridges are only identified from the side."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Rond sur la photo : culot ou pointe d'une cartouche, ou une balle ronde. Les cartouches ne sont identifiées que de côté."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
