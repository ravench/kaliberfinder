    "Lege die Patrone flach auf einen hellen Untergrund und halte das Gerät parallel, 20–30 cm darüber.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Lay the cartridge flat on a light surface and hold the device parallel, 20–30 cm above it."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Posez la cartouche à plat sur un fond clair et tenez l'appareil parallèle, à 20–30 cm au-dessus."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Appoggia la cartuccia piatta su un fondo chiaro e tieni il dispositivo parallelo, 20–30 cm sopra."
          }
        }
      }
    },
    "Lege die Patrone flach auf einen hellen Untergrund und halte das Gerät parallel, gut %lld cm darüber.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Lay the cartridge flat on a light background and hold the device parallel, a good %lld cm above it."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Posez la cartouche à plat sur un fond clair et tenez l'appareil parallèle, à un bon %lld cm au-dessus."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Appoggia la cartuccia su uno sfondo chiaro e tieni il dispositivo parallelo, a un buon %lld cm sopra."
          }
        }
      }
    },
    "Lege die Patrone flach auf einen hellen Untergrund und halte das Gerät parallel, so nah wie es scharf stellt.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Lay the cartridge flat on a light background and hold the device parallel, as close as it focuses."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Posez la cartouche à plat sur un fond clair et tenez l'appareil parallèle, aussi près qu'il fait la mise au point."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Appoggia la cartuccia su uno sfondo chiaro e tieni il dispositivo parallelo, vicino quanto mette a fuoco."
          }
        }
      }
    },
    "Lege eine Bankkarte (oder ID, Führerausweis) hochkant auf das Rechteck, oben bündig, und verschiebe den Regler, bis das Rechteck genau so lang ist wie die Karte.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Lay a bank card (or ID card, driving licence) upright on the rectangle, flush at the top, and move the slider until the rectangle is exactly as long as the card."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Posez une carte bancaire (ou carte d'identité, permis de conduire) verticalement sur le rectangle, alignée en haut, et déplacez le curseur jusqu'à ce que le rectangle soit exactement aussi long que la carte."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Appoggia una carta bancaria (o carta d'identità, licenza di condurre) in verticale sul rettangolo, allineata in alto, e sposta il cursore finché il rettangolo è lungo esattamente come la carta."
          }
        }
      }
    },
