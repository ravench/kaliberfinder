    "Lege die Patrone flach auf einen hellen Untergrund und halte das Gerät parallel, 20–30 cm darüber.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Lay the cartridge flat on a light background and hold the device parallel, 20–30 cm above it."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Coloca el cartucho tumbado sobre un fondo claro y sostén el dispositivo en paralelo, a 20–30 cm por encima."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Posez la cartouche à plat sur un fond clair et tenez l'appareil parallèle, à 20–30 cm au-dessus."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Appoggia la cartuccia di lato su uno sfondo chiaro e tieni il dispositivo parallelo, a 20–30 cm di altezza."
          }
        }
      }
    },
    "Lege die Patrone flach auf einen hellen Untergrund und halte das Gerät parallel, gut %lld cm darüber.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Lay the cartridge flat on a light background and hold the device parallel, a good %lld cm above it."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Coloca el cartucho tumbado sobre un fondo claro y sostén el dispositivo en paralelo, a algo más de %lld cm por encima."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Posez la cartouche à plat sur un fond clair et tenez l'appareil parallèle, à un peu plus de %lld cm au-dessus."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Appoggia la cartuccia di lato su uno sfondo chiaro e tieni il dispositivo parallelo, a poco più di %lld cm di altezza."
          }
        }
      }
    },
    "Lege die Patrone flach auf einen hellen Untergrund und halte das Gerät parallel, so nah, wie es scharf stellt.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Lay the cartridge flat on a light background and hold the device parallel, as close as it will focus."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Coloca el cartucho tumbado sobre un fondo claro y sostén el dispositivo en paralelo, tan cerca como permita el enfoque."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Posez la cartouche à plat sur un fond clair et tenez l'appareil parallèle, aussi près que la mise au point le permet."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Appoggia la cartuccia di lato su uno sfondo chiaro e tieni il dispositivo parallelo, il più vicino possibile senza perdere la messa a fuoco."
          }
        }
      }
    },
