    "Nur ein Kreis erkannt: Bitte Patrone von der Seite fotografieren.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Only a circle detected: please photograph the cartridge from the side."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Solo se ha detectado un círculo: fotografía el cartucho de lado."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Seulement un cercle détecté : veuillez photographier la cartouche de côté."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Rilevato solo un cerchio: fotografa la cartuccia di lato."
          }
        }
      }
    },
    "Nur zur Bestimmung: Ein Treffer ist keine Freigabe zum Schiessen. Prüfe Bodenstempel und Kaliberangabe der Waffe.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "For identification only: a match does not mean a cartridge is safe to fire. Check the headstamp and the calibre marked on the firearm."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Solo para identificar: una coincidencia no autoriza a disparar. Comprueba el marcaje del culote y el calibre indicado en el arma."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Pour l'identification seulement : une correspondance n'autorise pas le tir. Vérifiez le marquage du culot et le calibre indiqué sur l'arme."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Solo per l'identificazione: una corrispondenza non autorizza a sparare. Controlla il fondello e il calibro indicato sull'arma."
          }
        }
      }
    },
