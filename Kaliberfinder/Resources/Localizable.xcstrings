    "Bankkarte oder Ausweis hochkant auf das Rechteck legen, oben bündig. Regler schieben, bis das Rechteck gleich lang ist.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Lay a bank card or ID upright on the rectangle, flush at the top. Move the slider until the rectangle is as long as the card."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Coloca una tarjeta bancaria o un documento de identidad en vertical sobre el rectángulo, con el borde superior alineado. Arrastra el regulador hasta que el rectángulo sea tan largo como la tarjeta."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Posez une carte bancaire ou d'identité verticalement sur le rectangle, alignée en haut. Déplacez le curseur jusqu'à ce que le rectangle ait la même longueur."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Appoggia una carta bancaria o d'identità in verticale sul rettangolo, allineata in alto. Sposta il cursore finché il rettangolo è lungo quanto la carta."
          }
        }
      }
    },
