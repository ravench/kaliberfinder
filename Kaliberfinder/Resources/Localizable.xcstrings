    "Selten: wird kaum je gefunden. Ein Treffer ist eher eine ähnliche Patrone, also genau nachmessen.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Rare: hardly ever found. A match is more likely a similar cartridge, so measure carefully."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Rare : presque jamais trouvé. Une correspondance est plutôt une cartouche semblable, mesurez donc avec soin."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Raro: non si trova quasi mai. Una corrispondenza è più probabilmente una cartuccia simile, quindi misura con cura."
          }
        }
      }
    },
