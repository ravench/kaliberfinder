    "Speichert Fotoserien bekannter Patronen mit den Messwerten der App auf dem Gerät, als Testdaten für die Erkennung.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Saves photo series of known cartridges with the app's measurements on the device, as test data for recognition."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Guarda en el dispositivo series de fotos de cartuchos conocidos con las mediciones de la app, como datos de prueba para el reconocimiento."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Enregistre sur l'appareil des séries de photos de cartouches connues avec les mesures de l'app, comme données de test pour la reconnaissance."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Salva sul dispositivo serie di foto di cartucce note con le misure dell'app, come dati di prova per il riconoscimento."
          }
        }
      }
    },
