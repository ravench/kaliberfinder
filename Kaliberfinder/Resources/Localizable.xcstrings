    "Tipp: seitlich auf einfarbigen hellen Grund legen, senkrecht von oben fotografieren.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Tip: lay it on its side on a plain light background and photograph it straight from above."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Conseil : posez-la de côté sur un fond clair uni et photographiez-la à la verticale."
