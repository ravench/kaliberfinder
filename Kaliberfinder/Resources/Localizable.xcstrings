    "Patrone seitlich auf einen hellen Untergrund legen und von oben fotografieren. Eine Aufschrift auf dem Boden oder der Schachtel hilft zusätzlich.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Lay the cartridge on its side on a light background and photograph it from above. A marking on the base or the box helps too."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Posez la cartouche sur le côté sur un fond clair et photographiez-la d'en haut. Une inscription sur le culot ou la boîte aide aussi."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Appoggia la cartuccia di lato su uno sfondo chiaro e fotografala dall'alto. Anche una scritta sul fondello o sulla scatola aiuta."
          }
        }
      }
    },
